{
  "name": "entree-backend",
  "version": "1.0.0",
  "description": "Entrée Backend built around the MachineNova Event API",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test tests/*.test.ts tests/endpoints/*.test.ts",
    "db:setup": "tsx -e \"import('./src/db/database.js').then(m => m.initDatabase()).then(() => import('./src/db/seed.js')).then(m => m.seedInitialData()).then(() => { console.log('[DATABASE] Setup complete.'); process.exit(0); })\"",
    "db:seed": "npm run db:setup"
  },
  "keywords": [
    "entree",
    "machinenova",
    "event-api",
    "check-in",
    "flutter-backend"
  ],
  "author": "Kelvin Matheka",
  "license": "ISC",
  "dependencies": {
    "axios": "^1.7.9",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "pg-mem": "^3.0.14",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.13.9",
    "@types/pg": "^8.23.1",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
